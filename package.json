{
  "name": "crypto-lab-paillier-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && gh-pages -d dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "verify": "tsx scripts/verify.ts",
    "check": "tsc --noEmit && vitest run && npm run verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
