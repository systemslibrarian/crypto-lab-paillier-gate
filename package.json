{
  "name": "crypto-lab-paillier-gate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && tsc --noEmit && vite build",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-paillier-gate --ref main",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "verify": "tsx scripts/verify.ts",
    "check": "tsc --noEmit && vitest run && npm run verify",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
